# Cell 2 — Full rewritten Colab torrent downloader (fixed magnet/.torrent handling)
# Features:
# - Correctly detects magnet vs http(s) .torrent URLs (fixes URLError unknown url type: magnet)
# - Google Drive mount + local fallback
# - File selection/priorities (prioritize_files)
# - Progress bars (metadata + download + integrity check)
# - Auto-repair loop (re-download bad pieces after failed hash check)
# - On-disk file existence/size verification
# - Auto-saved text report per torrent
# - Keeps running (no auto-exit) after processing all torrents

import os
import re
import time
import datetime
import libtorrent as lt
from tqdm.auto import tqdm
from google.colab import drive
from urllib.parse import urlparse

# ------------------ Config ------------------
MAX_REPAIR_ATTEMPTS = 5          # recheck/repair cycles
INTEGRITY_TIMEOUT_S = 3600       # 1 hour max hashing (big torrents may need more)
KEEP_ALIVE_AFTER_ALL = True      # keep cell running at end

# ------------------ Helpers ------------------
def fmt_bytes(n: float) -> str:
    n = float(n)
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if n < 1024:
            return f"{n:.2f}{unit}"
        n /= 1024
    return f"{n:.2f}PB"

def safe_filename(name: str, max_len: int = 120) -> str:
    name = re.sub(r"[\\/:*?\"<>|]+", "_", name).strip()
    name = re.sub(r"\s+", " ", name)
    return name[:max_len] if len(name) > max_len else name

def ensure_dir(path: str) -> str:
    os.makedirs(path, exist_ok=True)
    return path

def save_report(save_path: str, base_name: str, lines: list[str]) -> str:
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    report_name = f"{safe_filename(base_name)}__report__{ts}.txt"
    report_path = os.path.join(save_path, report_name)
    with open(report_path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines).rstrip() + "\n")
    return report_path

def is_magnet(link: str) -> bool:
    return link.strip().lower().startswith("magnet:?")

def is_http_torrent_url(link: str) -> bool:
    """
    True only for http(s) URLs whose PATH ends with .torrent
    (ignores querystring so .torrent?token=... works)
    """
    link = link.strip()
    p = urlparse(link)
    if p.scheme not in ("http", "https"):
        return False
    return p.path.lower().endswith(".torrent")

def verify_files_on_disk(save_path: str, torrent_info: lt.torrent_info, priorities: list[int]):
    fs = torrent_info.files()
    summary = []
    missing = 0
    ok = 0
    checked = 0

    for idx in range(fs.num_files()):
        if priorities and idx < len(priorities) and priorities[idx] <= 0:
            continue

        rel = fs.file_path(idx)
        expected = fs.file_size(idx)
        full = os.path.join(save_path, rel)

        checked += 1
        if os.path.exists(full):
            actual = os.path.getsize(full)
            if actual == expected:
                ok += 1
                status = "OK"
            else:
                status = "SIZE_MISMATCH"
            summary.append(f"[{idx}] {status} | {rel} | expected={fmt_bytes(expected)} actual={fmt_bytes(actual)}")
        else:
            missing += 1
            summary.append(f"[{idx}] MISSING | {rel} | expected={fmt_bytes(expected)}")

    header = [
        "---- On-disk verification ----",
        f"Checked files: {checked}",
        f"OK: {ok}",
        f"Missing: {missing}",
    ]
    return header + summary, missing, ok, checked

def wait_for_metadata(handle: lt.torrent_handle):
    print("Fetching metadata (no timeout)...")
    with tqdm(desc="Metadata", unit="s", dynamic_ncols=True) as mbar:
        while not handle.has_metadata():
            time.sleep(1)
            mbar.update(1)

def compute_total_wanted(handle: lt.torrent_handle, torrent_info: lt.torrent_info, priorities: list[int]) -> int:
    time.sleep(1)
    s = handle.status()
    total = int(getattr(s, "total_wanted", 0) or 0)
    if total > 0:
        return total

    fs = torrent_info.files()
    total = 0
    for idx in range(fs.num_files()):
        if priorities and idx < len(priorities) and priorities[idx] > 0:
            total += fs.file_size(idx)
    return int(total)

def download_until_complete(handle: lt.torrent_handle, total: int, title: str) -> None:
    """
    Blocks until total_wanted_done >= total (100.0000% for selected content).
    """
    pbar = tqdm(
        total=total,
        desc=title,
        unit="B",
        unit_scale=True,
        unit_divisor=1024,
        dynamic_ncols=True,
        leave=True,
    )

    last_done = 0
    last_update = time.time()
    UPDATE_EVERY = 1.0

    try:
        while True:
            s = handle.status()
            done = int(getattr(s, "total_wanted_done", 0) or 0)

            delta = max(0, done - last_done)
            if delta:
                pbar.update(delta)
                last_done = done

            now = time.time()
            if now - last_update >= UPDATE_EVERY:
                down = float(getattr(s, "download_rate", 0.0) or 0.0)
                up = float(getattr(s, "upload_rate", 0.0) or 0.0)
                peers = int(getattr(s, "num_peers", 0) or 0)

                remaining = max(0, total - done)
                eta = remaining / down if down > 0 else float("inf")
                eta_str = "∞" if eta == float("inf") else f"{int(eta//60)}m{int(eta%60)}s"

                pct = (done / total * 100) if total > 0 else 0.0
                pbar.set_postfix_str(
                    f"{pct:.4f}% ↓{fmt_bytes(down)}/s ↑{fmt_bytes(up)}/s peers:{peers} ETA:{eta_str}"
                )
                last_update = now

            if total > 0 and done >= total:
                break

            time.sleep(0.2)
    finally:
        s = handle.status()
        final_done = min(total, int(getattr(s, "total_wanted_done", 0) or 0))
        if final_done > last_done:
            pbar.update(final_done - last_done)
        pbar.close()

def integrity_recheck(handle: lt.torrent_handle, report_lines: list[str], timeout_s: int) -> bool:
    """
    Piece-hash verification with progress bar. Returns True if OK.
    If failed, libtorrent will mark bad pieces and will need to redownload them.
    """
    print("\nRunning integrity check (piece hash verify)...")
    report_lines.append("---- Integrity check ----")
    report_lines.append("Integrity check: starting (force_recheck)")

    try:
        handle.pause()
    except Exception:
        pass
    time.sleep(0.5)

    try:
        handle.force_recheck()
    except Exception as e:
        report_lines.append(f"Integrity check: force_recheck() failed: {repr(e)}")
        print("Integrity check failed to start:", e)
        try:
            handle.resume()
        except Exception:
            pass
        return False

    t_start = time.time()
    last_pct = -1
    entered_checking = False

    with tqdm(desc="Integrity check", unit="%", total=100, dynamic_ncols=True) as cbar:
        while True:
            s = handle.status()

            # error field exists in some builds; keep it safe
            err = ""
            try:
                err = str(getattr(s, "error", "")) or ""
            except Exception:
                err = ""
            if err:
                print("Integrity check error:", err)
                report_lines.append(f"Integrity check error: {err}")
                break

            in_check = (s.state == lt.torrent_status.checking_files)
            if in_check:
                entered_checking = True

            pct = int(max(0.0, min(1.0, float(getattr(s, "progress", 0.0) or 0.0))) * 100)

            if pct != last_pct:
                if last_pct < 0:
                    cbar.n = pct
                    cbar.refresh()
                else:
                    cbar.update(max(0, pct - last_pct))
                last_pct = pct

            # done once we entered checking and then leave it
            if entered_checking and not in_check:
                break

            if time.time() - t_start > timeout_s:
                print("Integrity check timeout.")
                report_lines.append("Integrity check: TIMEOUT")
                break

            time.sleep(0.5)

    try:
        handle.resume()
    except Exception:
        pass

    s = handle.status()
    integrity_ok = False
    if s.state == lt.torrent_status.seeding:
        integrity_ok = True
    elif s.state == lt.torrent_status.finished and float(getattr(s, "progress", 0.0) or 0.0) >= 0.999:
        integrity_ok = True

    print("Integrity check result:", "OK" if integrity_ok else "FAILED/INCOMPLETE")
    report_lines.append(f"Integrity check result: {'OK' if integrity_ok else 'FAILED/INCOMPLETE'}")
    report_lines.append(f"Post-check state: {int(s.state)}")
    report_lines.append(f"Post-check progress: {float(getattr(s, 'progress', 0.0) or 0.0)*100:.4f}%")
    return integrity_ok

def get_save_path(default_drive: str | None, default_local: str) -> str:
    if default_drive:
        choice = input("Save to (1) Drive or (2) Local? ").strip()
        return default_drive if choice == "1" else default_local
    return default_local

# ------------------ Mount Drive + Paths ------------------
default_save_path_drive = None
try:
    drive.mount("/content/drive")
    default_save_path_drive = ensure_dir("/content/drive/MyDrive/Torrent_Downloads")
    print("Drive path:", default_save_path_drive)
except Exception as e:
    print("Drive mount failed:", e)

default_save_path_local = ensure_dir("/content/Torrent_Downloads")
print("Local path:", default_save_path_local)

# ------------------ Libtorrent Session ------------------
ses = lt.session()

sp = ses.get_settings()
sp["listen_interfaces"] = "0.0.0.0:6881,[::]:6881"
sp["enable_dht"] = True
sp["enable_lsd"] = True
sp["enable_upnp"] = False
sp["enable_natpmp"] = False
sp["enable_outgoing_utp"] = True
sp["enable_incoming_utp"] = True
sp["enable_outgoing_tcp"] = True
sp["enable_incoming_tcp"] = True
sp["connections_limit"] = 200
sp["active_downloads"] = 10
sp["active_seeds"] = 10
sp["alert_mask"] = lt.alert.category_t.status_notification | lt.alert.category_t.error_notification
ses.apply_settings(sp)

ses.start_dht()
try:
    ses.add_dht_router("router.bittorrent.com", 6881)
    ses.add_dht_router("router.utorrent.com", 6881)
    ses.add_dht_router("router.utorrent.com", 6881)
    ses.add_dht_router("dht.transmissionbt.com", 6881)
except Exception:
    pass

# ------------------ Input Links ------------------
magnet_links_input = os.environ.get("MAGNET_LINKS")
if not magnet_links_input:
    magnet_links_input = input("Enter magnet/http(s) .torrent links (comma-separated), or blank for one-by-one: ").strip()

links_to_process = []
if magnet_links_input:
    links_to_process = [x.strip() for x in magnet_links_input.split(",") if x.strip()]
else:
    while True:
        x = input("Enter link (Enter to finish): ").strip()
        if not x:
            break
        links_to_process.append(x)

if not links_to_process:
    print("No links provided. Exiting.")
    raise SystemExit

# ------------------ Process Each Link ------------------
for idx_link, original_link in enumerate(links_to_process, start=1):
    link = original_link
    print(f"\n=== Processing {idx_link}/{len(links_to_process)} ===")

    save_path = get_save_path(default_save_path_drive, default_save_path_local)
    print("Download path:", save_path)

    # Convert http(s) .torrent -> magnet; magnet stays as-is
    if is_http_torrent_url(link):
        import wget
        from torf import Torrent

        tmp = f"tmp_{idx_link}.torrent"
        if os.path.exists(tmp):
            os.remove(tmp)

        print("Downloading .torrent ...")
        wget.download(link, tmp)
        t = Torrent.read(tmp)
        link = t.magnet()
        os.remove(tmp)
        print("\nConverted to magnet.")
    elif is_magnet(link):
        pass
    else:
        print("Unsupported link type. Use a magnet link or an http(s) URL ending in .torrent")
        continue

    params = {"save_path": save_path, "storage_mode": lt.storage_mode_t(2)}

    print("Magnet:", link)

    h = lt.add_magnet_uri(ses, link, params)
    h.set_sequential_download(False)

    report = []
    started = datetime.datetime.now()
    report.append("TORRENT DOWNLOAD REPORT")
    report.append(f"Started: {started}")
    report.append(f"Save path: {save_path}")
    report.append(f"Original link: {original_link}")
    report.append(f"Magnet used: {link}")

    # Metadata (no timeout)
    t0_meta = time.time()
    wait_for_metadata(h)
    report.append("Metadata received: True")
    report.append(f"Metadata time: {time.time() - t0_meta:.1f}s")

    ti = h.torrent_file()
    fs = ti.files()
    name = h.name()
    report.append(f"Torrent name: {name}")
    print("\nTorrent:", name)

    # Show files
    file_lines = []
    print("\nFiles:")
    for f_idx in range(fs.num_files()):
        line = f"[{f_idx}] {fs.file_path(f_idx)} ({fs.file_size(f_idx)/(1024*1024):.2f} MB)"
        file_lines.append(line)
        print(line)

    # Choose priorities
    selected = input("Prioritize file numbers (e.g. 0,2) or Enter for all: ").strip()
    priorities = [1] * fs.num_files()
    selected_indices = None

    if selected:
        priorities = [0] * fs.num_files()
        selected_indices = []
        for part in selected.split(","):
            part = part.strip()
            if not part:
                continue
            try:
                n = int(part)
                if 0 <= n < fs.num_files():
                    priorities[n] = 7
                    selected_indices.append(n)
                else:
                    print(f"Warning: ignoring invalid index {n}")
            except ValueError:
                print(f"Warning: ignoring invalid input '{part}'")

    h.prioritize_files(priorities)

    report.append("---- Files ----")
    report.extend(file_lines)
    if selected_indices:
        report.append("---- Prioritized files (priority=7) ----")
        for n in selected_indices:
            report.append(f"[{n}] {fs.file_path(n)}")
    else:
        report.append("Prioritized files: None (all normal)")

    total = compute_total_wanted(h, ti, priorities)
    report.append(f"Total wanted: {fmt_bytes(total)}")

    # Auto-repair loop
    integrity_ok = False
    for attempt in range(1, MAX_REPAIR_ATTEMPTS + 1):
        report.append(f"---- Repair attempt {attempt} ----")
        print(f"\n[Attempt {attempt}] Downloading until 100.0000% ...")

        try:
            h.resume()
        except Exception:
            pass

        t0 = time.time()
        download_until_complete(h, total, title=f"Downloading: {name} (attempt {attempt})")
        dt = time.time() - t0

        done = min(total, int(h.status().total_wanted_done))
        report.append(f"Attempt {attempt} downloaded: {fmt_bytes(done)} / {fmt_bytes(total)}")
        report.append(f"Attempt {attempt} elapsed: {int(dt//60)}m {int(dt%60)}s")
        report.append(f"Attempt {attempt} avg speed: {fmt_bytes(done/dt)}/s" if dt > 0 else "Attempt avg speed: N/A")

        integrity_ok = integrity_recheck(h, report, timeout_s=INTEGRITY_TIMEOUT_S)
        if integrity_ok:
            print("Integrity OK ✅")
            break

        print("Integrity failed ❌ — continuing to re-download bad pieces...")
        report.append("Integrity failed: will continue downloading bad pieces")

        time.sleep(1)

    # On-disk verification
    verify_lines, missing, ok, checked = verify_files_on_disk(save_path, ti, priorities)
    print("\nOn-disk verification summary:")
    print(f"Checked: {checked} | OK: {ok} | Missing: {missing}")
    report.extend(verify_lines)

    ended = datetime.datetime.now()
    report.append(f"Ended: {ended}")

    final_done = int(h.status().total_wanted_done)
    final_complete = (final_done >= total and missing == 0 and integrity_ok)
    report.append("Status: COMPLETE" if final_complete else "Status: INCOMPLETE/FAILED_INTEGRITY_OR_MISSING_FILES")

    rp = save_report(save_path, name, report)
    print("Saved report:", rp)

# Keep alive (no auto-exit)
if KEEP_ALIVE_AFTER_ALL:
    print("\nAll torrents processed. Keeping session alive (no auto-exit).")
    print("Interrupt the cell (Runtime > Interrupt execution) when you want to stop.")
    while True:
        time.sleep(60)
