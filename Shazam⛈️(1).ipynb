# Cell 2 — Optimized torrent downloader with:
# - tqdm progress bars (metadata + download + integrity check)
# - file selection / priorities
# - auto-saved text report
# - on-disk file existence/size verification
# - integrity verification via libtorrent piece-hash recheck (force_recheck)

import os
import re
import time
import datetime
import libtorrent as lt
from tqdm.auto import tqdm
from google.colab import drive

# ------------------ Helpers ------------------
def fmt_bytes(n: float) -> str:
    n = float(n)
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if n < 1024:
            return f"{n:.2f}{unit}"
        n /= 1024
    return f"{n:.2f}PB"

def is_torrent_url(link: str) -> bool:
    return ".torrent" in link.lower()

def ensure_dir(path: str) -> str:
    os.makedirs(path, exist_ok=True)
    return path

def safe_filename(name: str, max_len: int = 120) -> str:
    name = re.sub(r"[\\/:*?\"<>|]+", "_", name).strip()
    name = re.sub(r"\s+", " ", name)
    return name[:max_len] if len(name) > max_len else name

def save_report(save_path: str, base_name: str, lines: list[str]) -> str:
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    report_name = f"{safe_filename(base_name)}__report__{ts}.txt"
    report_path = os.path.join(save_path, report_name)
    with open(report_path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines).rstrip() + "\n")
    return report_path

def verify_files_on_disk(save_path: str, torrent_info: lt.torrent_info, priorities: list[int]):
    """
    Checks expected files from torrent metadata against the filesystem.
    Only checks files with priority > 0 (intended to download).
    Returns: (lines, missing_count, ok_count, total_checked)
    """
    fs = torrent_info.files()
    summary = []
    missing = 0
    ok = 0
    checked = 0

    for idx in range(fs.num_files()):
        if priorities and idx < len(priorities) and priorities[idx] <= 0:
            continue

        rel = fs.file_path(idx)
        expected = fs.file_size(idx)
        full = os.path.join(save_path, rel)

        checked += 1
        if os.path.exists(full):
            actual = os.path.getsize(full)
            if actual == expected:
                ok += 1
                status = "OK"
            else:
                status = "SIZE_MISMATCH"
            summary.append(f"[{idx}] {status} | {rel} | expected={fmt_bytes(expected)} actual={fmt_bytes(actual)}")
        else:
            missing += 1
            summary.append(f"[{idx}] MISSING | {rel} | expected={fmt_bytes(expected)}")

    header = [
        "---- On-disk verification ----",
        f"Checked files: {checked}",
        f"OK: {ok}",
        f"Missing: {missing}",
    ]
    return header + summary, missing, ok, checked

def integrity_recheck(handle: lt.torrent_handle, report_lines: list[str], timeout_s: int = 3600) -> bool:
    """
    Performs piece-hash verification using libtorrent:
    - pause torrent
    - force_recheck (hash verify)
    - progress bar while checking_files
    Returns True if integrity is OK (seeding or finished with ~100% progress).
    """
    print("\nRunning integrity check (piece hash verify)...")
    report_lines.append("---- Integrity check ----")
    report_lines.append("Integrity check: starting (force_recheck)")

    # Pause to reduce disk churn while verifying
    try:
        handle.pause()
    except Exception:
        pass
    time.sleep(0.5)

    # Force recheck
    try:
        handle.force_recheck()
    except Exception as e:
        report_lines.append(f"Integrity check: force_recheck() failed: {repr(e)}")
        print("Integrity check failed to start:", e)
        try:
            handle.resume()
        except Exception:
            pass
        return False

    t_start = time.time()
    last_pct = -1

    with tqdm(desc="Integrity check", unit="%", total=100, dynamic_ncols=True) as cbar:
        while True:
            s = handle.status()

            # Some builds expose error as a field; handle safely
            err = ""
            try:
                err = str(getattr(s, "error", "")) or ""
            except Exception:
                err = ""
            if err:
                print("Integrity check error:", err)
                report_lines.append(f"Integrity check error: {err}")
                break

            # During checking_files, progress reflects check progress in many builds
            in_check = (s.state == lt.torrent_status.checking_files)
            pct = int(max(0.0, min(1.0, s.progress)) * 100)

            if pct != last_pct:
                if last_pct < 0:
                    cbar.n = pct
                    cbar.refresh()
                else:
                    cbar.update(max(0, pct - last_pct))
                last_pct = pct

            # When it leaves checking_files after having entered, we consider check done
            if (not in_check) and last_pct >= 0:
                break

            if time.time() - t_start > timeout_s:
                print("Integrity check timeout.")
                report_lines.append("Integrity check: TIMEOUT")
                break

            time.sleep(0.5)

    # Resume (optional)
    try:
        handle.resume()
    except Exception:
        pass

    s = handle.status()
    integrity_ok = False
    if s.state == lt.torrent_status.seeding:
        integrity_ok = True
    elif s.state == lt.torrent_status.finished and s.progress >= 0.999:
        integrity_ok = True

    print("Integrity check result:", "OK" if integrity_ok else "FAILED/INCOMPLETE")
    report_lines.append(f"Integrity check result: {'OK' if integrity_ok else 'FAILED/INCOMPLETE'}")
    report_lines.append(f"Post-check state: {int(s.state)}")
    report_lines.append(f"Post-check progress: {s.progress*100:.2f}%")

    return integrity_ok

# ------------------ Mount Drive + Paths ------------------
default_save_path_drive = None
try:
    drive.mount("/content/drive")
    default_save_path_drive = ensure_dir("/content/drive/MyDrive/Torrent_Downloads")
    print("Drive path:", default_save_path_drive)
except Exception as e:
    print("Drive mount failed:", e)

default_save_path_local = ensure_dir("/content/Torrent_Downloads")
print("Local path:", default_save_path_local)

# ------------------ Libtorrent Session (optimized) ------------------
ses = lt.session()

sp = ses.get_settings()
sp["listen_interfaces"] = "0.0.0.0:6881,[::]:6881"
sp["enable_dht"] = True
sp["enable_lsd"] = True
sp["enable_upnp"] = False
sp["enable_natpmp"] = False
sp["enable_outgoing_utp"] = True
sp["enable_incoming_utp"] = True
sp["enable_outgoing_tcp"] = True
sp["enable_incoming_tcp"] = True
sp["connections_limit"] = 200
sp["active_downloads"] = 10
sp["active_seeds"] = 10
sp["alert_mask"] = lt.alert.category_t.status_notification | lt.alert.category_t.error_notification
ses.apply_settings(sp)

ses.start_dht()
try:
    ses.add_dht_router("router.bittorrent.com", 6881)
    ses.add_dht_router("router.utorrent.com", 6881)
    ses.add_dht_router("dht.transmissionbt.com", 6881)
except Exception:
    pass

# ------------------ Input Links ------------------
magnet_links_input = os.environ.get("MAGNET_LINKS")
if not magnet_links_input:
    magnet_links_input = input("Enter torrent/magnet links (comma-separated), or blank for one-by-one: ").strip()

links_to_process = []
if magnet_links_input:
    links_to_process = [x.strip() for x in magnet_links_input.split(",") if x.strip()]
else:
    while True:
        x = input("Enter link (Enter to finish): ").strip()
        if not x:
            break
        links_to_process.append(x)

if not links_to_process:
    print("No links provided. Exiting.")
    raise SystemExit

# ------------------ Process Each Link ------------------
for i, original_link in enumerate(links_to_process, start=1):
    link = original_link
    print(f"\n=== {i}/{len(links_to_process)} ===")

    # Choose download path
    if default_save_path_drive:
        choice = input("Save to (1) Drive or (2) Local? ").strip()
        save_path = default_save_path_drive if choice == "1" else default_save_path_local
    else:
        save_path = default_save_path_local
    print("Download path:", save_path)

    params = {
        "save_path": save_path,
        "storage_mode": lt.storage_mode_t(2),
    }

    # ---- .torrent URL -> magnet ----
    if is_torrent_url(link):
        import wget
        from torf import Torrent

        tmp = f"tmp_{i}.torrent"
        try:
            if os.path.exists(tmp):
                os.remove(tmp)
            print("Downloading .torrent ...")
            wget.download(link, tmp)
            t = Torrent.read(tmp)
            link = t.magnet()
            os.remove(tmp)
            print("\nConverted to magnet.")
        except Exception as e:
            print("Failed to process .torrent:", e)
            fail_lines = [
                "TORRENT DOWNLOAD REPORT",
                "Status: FAILED (.torrent conversion)",
                f"Time: {datetime.datetime.now()}",
                f"Original link: {original_link}",
                f"Error: {repr(e)}",
            ]
            rp = save_report(save_path, "failed_torrent", fail_lines)
            print("Saved report:", rp)
            continue

    print("Magnet:", link)

    # Add magnet
    h = lt.add_magnet_uri(ses, link, params)
    h.set_sequential_download(False)

    report_lines = []
    start_time = datetime.datetime.now()
    report_lines.append("TORRENT DOWNLOAD REPORT")
    report_lines.append(f"Started: {start_time}")
    report_lines.append(f"Save path: {save_path}")
    report_lines.append(f"Original link: {original_link}")
    report_lines.append(f"Magnet used: {link}")

    # ------------------ Metadata with timeout + bar ------------------
    META_TIMEOUT = 120
    t0_meta = time.time()
    print("Fetching metadata...")

    with tqdm(total=META_TIMEOUT, desc="Metadata", unit="s", dynamic_ncols=True) as mbar:
        while not h.has_metadata():
            if time.time() - t0_meta > META_TIMEOUT:
                print("\nMetadata timeout. Skipping.")
                h.pause()
                break
            time.sleep(1)
            mbar.update(1)

    got_metadata = h.has_metadata()
    meta_elapsed = time.time() - t0_meta
    report_lines.append(f"Metadata received: {got_metadata}")
    report_lines.append(f"Metadata time: {meta_elapsed:.1f}s")

    if not got_metadata:
        end_time = datetime.datetime.now()
        report_lines.append(f"Ended: {end_time}")
        report_lines.append("Status: FAILED (metadata timeout)")
        rp = save_report(save_path, "metadata_timeout", report_lines)
        print("Saved report:", rp)
        continue

    ti = h.torrent_file()
    fs = ti.files()
    name = h.name()
    print("\nTorrent:", name)
    report_lines.append(f"Torrent name: {name}")

    # ------------------ File list ------------------
    file_lines = []
    for idx in range(fs.num_files()):
        file_lines.append(f"[{idx}] {fs.file_path(idx)} ({fs.file_size(idx)/(1024*1024):.2f} MB)")

    print("\nFiles:")
    for line in file_lines:
        print(line)

    # Prioritize selected files
    selected = input("Prioritize file numbers (e.g. 0,2) or Enter for all: ").strip()
    priorities = [1] * fs.num_files()
    selected_indices = None

    if selected:
        priorities = [0] * fs.num_files()
        try:
            selected_indices = [int(x.strip()) for x in selected.split(",") if x.strip()]
            for idx in selected_indices:
                if 0 <= idx < fs.num_files():
                    priorities[idx] = 7
                else:
                    print(f"Warning: ignoring invalid index {idx}")
        except ValueError:
            print("Invalid input. Downloading all normally.")
            priorities = [1] * fs.num_files()
            selected_indices = None

    h.prioritize_files(priorities)

    report_lines.append("---- Files ----")
    report_lines.extend(file_lines)
    if selected_indices:
        report_lines.append("---- Prioritized files (priority=7) ----")
        for idx in selected_indices:
            if 0 <= idx < fs.num_files():
                report_lines.append(f"[{idx}] {fs.file_path(idx)}")
    else:
        report_lines.append("Prioritized files: None (all normal)")

    # ------------------ Download progress bar ------------------
    begin = time.time()

    time.sleep(1)
    s = h.status()
    total = s.total_wanted if s.total_wanted > 0 else 0
    if total <= 0:
        total = sum(fs.file_size(idx) for idx in range(fs.num_files()) if priorities[idx] > 0)

    report_lines.append(f"Total wanted: {fmt_bytes(total)}")

    pbar = tqdm(
        total=total,
        desc=f"Downloading: {name}",
        unit="B",
        unit_scale=True,
        unit_divisor=1024,
        dynamic_ncols=True,
        leave=True,
    )

    last_done = 0
    last_update = time.time()
    UPDATE_EVERY = 1.0

    stopped_early = False

    try:
        while True:
            s = h.status()

            # done?
            if s.state == lt.torrent_status.seeding or (s.total_wanted > 0 and s.total_wanted_done >= s.total_wanted):
                break

            now = time.time()
            if now - last_update >= UPDATE_EVERY:
                done = s.total_wanted_done
                delta = max(0, done - last_done)
                if delta:
                    pbar.update(delta)
                    last_done = done

                down = s.download_rate
                up = s.upload_rate
                peers = s.num_peers
                remaining = max(0, total - done)
                eta = remaining / down if down > 0 else float("inf")
                eta_str = "∞" if eta == float("inf") else f"{int(eta//60)}m{int(eta%60)}s"

                pbar.set_postfix_str(
                    f"↓{fmt_bytes(down)}/s ↑{fmt_bytes(up)}/s peers:{peers} ETA:{eta_str}"
                )
                last_update = now

            if os.environ.get("TEST_MODE") == "True":
                stopped_early = True
                pbar.set_postfix_str("TEST_MODE: stopping early")
                break

            time.sleep(0.2)

    finally:
        s = h.status()
        final_done = min(total, s.total_wanted_done)
        if final_done > last_done:
            pbar.update(final_done - last_done)
        pbar.close()

    end = time.time()
    end_time = datetime.datetime.now()

    downloaded = min(total, h.status().total_wanted_done)
    elapsed = end - begin
    avg_speed = (downloaded / elapsed) if elapsed > 0 else 0.0

    print("\nDownload finished.")
    print("Downloaded:", fmt_bytes(downloaded), "/", fmt_bytes(total))
    print("Elapsed:", int(elapsed // 60), "min", int(elapsed % 60), "sec")

    report_lines.append(f"Download ended: {end_time}")
    report_lines.append(f"Downloaded: {fmt_bytes(downloaded)} / {fmt_bytes(total)}")
    report_lines.append(f"Elapsed: {int(elapsed//60)}m {int(elapsed%60)}s")
    report_lines.append(f"Average speed: {fmt_bytes(avg_speed)}/s")
    if stopped_early:
        report_lines.append("Note: stopped early due to TEST_MODE")

    # ------------------ On-disk verification BEFORE integrity check ------------------
    verify_lines, missing, ok, checked = verify_files_on_disk(save_path, ti, priorities)
    print("\nOn-disk verification summary:")
    print(f"Checked: {checked} | OK: {ok} | Missing: {missing}")
    report_lines.extend(verify_lines)

    # ------------------ Integrity check (piece hash verify) ------------------
    # Only run if we didn't intentionally stop early; otherwise recheck may look "failed" by design.
    integrity_ok = False
    if not stopped_early:
        integrity_ok = integrity_recheck(h, report_lines, timeout_s=3600)
    else:
        report_lines.append("---- Integrity check ----")
        report_lines.append("Integrity check skipped (TEST_MODE)")

    # ------------------ Final status + Save report ------------------
    # "Complete" requires: no missing files, downloaded >= total, and integrity OK
    final_complete = (missing == 0 and downloaded >= total and integrity_ok and not stopped_early)
    report_lines.append(f"Ended: {datetime.datetime.now()}")
    report_lines.append("Status: COMPLETE" if final_complete else "Status: INCOMPLETE/FAILED_INTEGRITY")

    rp = save_report(save_path, name, report_lines)
    print("Saved report:", rp)
